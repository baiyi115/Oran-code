{
  "name": "oran-code-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node dev.mjs",
    "build": "pnpm --filter @oran-code/cli build",
    "start": "node packages/oran-code/dist/cli.js",
    "test": "pnpm --filter @oran-code/cli test",
    "typecheck": "pnpm --filter @oran-code/cli typecheck",
    "dev:node": "node dev.mjs",
    "eval:resume": "node scripts/resume-eval.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "pnpm --filter @oran-code/cli test -- --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
