{
  "name": "@oran-code/cli",
  "version": "0.1.0",
  "description": "Oran code, a lightweight model-agnostic coding agent CLI.",
  "type": "module",
  "bin": {
    "oran": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "dev:node": "node --import tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "yaml": "^2.9.0"
  }
}
